{
  "info": {
    "name": "Sentinela — API",
    "description": "Todas as rotas da API do Sentinela. Rode primeiro 'Entrar (João)': o token fica guardado na variável {{token}}. 'Criar lavoura' guarda o id em {{cultivoId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "cultivoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Entrar (João)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao@exemplo.com\",\n  \"senha\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dados = pm.response.json();",
                  "if (dados.token) pm.collectionVariables.set('token', dados.token);",
                  "pm.test('status 200 ou 201', () => pm.expect([200, 201]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Entrar (administrador)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sentinela.com\",\n  \"senha\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dados = pm.response.json();",
                  "if (dados.token) pm.collectionVariables.set('token', dados.token);",
                  "pm.test('status 200 ou 201', () => pm.expect([200, 201]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Senha errada (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao@exemplo.com\",\n  \"senha\": \"errada\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Esqueci minha senha",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/esqueci-senha",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "esqueci-senha"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao@exemplo.com\"\n}"
            },
            "description": "Sem MAIL_HOST, o link aparece no log da API."
          }
        },
        {
          "name": "Criar nova senha",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/redefinir-senha",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "redefinir-senha"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<código do link>\",\n  \"novaSenha\": \"123456\"\n}"
            }
          }
        }
      ]
    },
