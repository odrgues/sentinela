# Variáveis de ambiente da API (src/backend). Em produção, ficam no Render.
# Obrigatórias: DB_URL, DB_USER, DB_PASSWORD e JWT_SECRET (sem elas a API não sobe).

# Banco de dados. Estes são os valores do MySQL do docker-compose (porta 3307).
DB_URL='jdbc:mysql://localhost:3307/sentinela?useSSL=false&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true'
DB_USER=root
DB_PASSWORD=root_local

# Segredo que assina o token de login. Qualquer texto longo em desenvolvimento; em produção, um valor aleatório.
JWT_SECRET=

# Porta da API. O Render define sozinho; sem ela, 8080.
PORT=8080

# Front: origens liberadas no CORS (separadas por vírgula) e endereço usado no link de nova senha.
FRONT_ORIGENS=http://localhost:5173
FRONT_URL=http://localhost:5173

# E-mail de nova senha (Gmail com senha de app). Sem MAIL_HOST, o link só aparece no log da API.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# Bot do WhatsApp: endereço da Evolution API (em produção, o domínio do ngrok, sem barra no fim)
# e a chave AUTHENTICATION_API_KEY dela.
EVOLUTION_API_URL=http://localhost:8082
EVOLUTION_API_KEY=
