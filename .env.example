# Banco de dados (sem estas variáveis, o backend usa o MySQL do docker-compose)
DB_URL=jdbc:mysql://localhost:3306/sentinela?useSSL=false&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true
DB_USER=
DB_PASSWORD=

# Segredo do token de login (obrigatório em produção)
JWT_SECRET=

# Front: origens liberadas no CORS (separadas por vírgula) e endereço do link de nova senha
FRONT_ORIGENS=http://localhost:5173
FRONT_URL=http://localhost:5173

# E-mail de nova senha (Gmail com senha de app). Vazio: o link só aparece no log do backend.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# GitHub (somente para a API: issues, labels, milestones)
GITHUB_TOKEN=

# WhatsApp Business Platform
WHATSAPP_TOKEN=

# Modelo de linguagem
LLM_API_KEY=
