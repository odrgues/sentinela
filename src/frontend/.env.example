# Endereço da API, sem a barra no fim. Vazio em desenvolvimento: o Vite repassa /api para
# http://localhost:8080. No build de produção, o endereço da API no Azure.
VITE_API_URL=

# Chave do Google Maps (Maps JavaScript, Places e Geocoding), restrita por site. Sem ela, a tela
# de marcar a lavoura mostra "Mapa desligado" e, em desenvolvimento, marca Uberaba – MG.
VITE_GOOGLE_MAPS_KEY=

# Map ID do Google Cloud, para os marcadores do painel. Vazio, usa o DEMO_MAP_ID (só para testes).
VITE_GOOGLE_MAP_ID=
